  "scripts": {
    "android": "expo start --android",
    "bake:strokes": "node scripts/bake-kanjivg.mjs",
    "check:edge": "deno check --config supabase/functions/deno.json supabase/functions/submit-reviews/index.ts",
    "export:web": "expo export --clear --platform web",
    "fonts:subset": "bash scripts/subset-kana-fonts.sh",
    "ios": "expo start --ios",
    "lint": "expo lint",
    "serve:web": "node scripts/serve-web.mjs",
    "smoke:supabase": "node --env-file-if-exists=.env.local scripts/smoke-supabase.mjs",
    "start": "expo start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run lint && npm test && npm run check:edge && npm run export:web",
    "web": "expo start --web"
  },
  "private": true
